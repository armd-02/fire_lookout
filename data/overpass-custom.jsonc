{
    "osm": {
        "fire_lookout": {
            "overpass": [
                "nwr[\"emergency\"=\"fire_lookout\"]"
            ],
            "tags": [
                "emergency=fire_lookout"
            ],
            "expression": {
                "poiView": true, // true時はアイコン表示
                "viewArea": false,
                "stroke": "#c0c0c0",
                "stroke-width": 1,
                "fill-opacity": 0.25
            }
        },
        "fire_station": {
            "overpass": [
                "nwr[\"amenity\"=\"fire_station\"]"
            ],
            "tags": [
                "amenity=fire_station"
            ],
            "expression": {
                "poiView": true, // true時はアイコン表示
                "viewArea": false,
                "stroke": "#c0c0c0",
                "stroke-width": 1,
                "fill-opacity": 0.25
            }
        },
        "place": {
            "overpass": [
                "nwr[\"place\"=\"quarter\"]"
            ],
            "tags": [
                "place=quarter"
            ],
            "expression": {
                "stroke": "#409040",
                "stroke-width": 2,
                "poiView": false, // true時はアイコン表示
                "viewArea": true,
                "fill-opacity": 0.5
            }
        }
    }
}